# MemoryFence environment configuration template.
#
# Phase 1 reads no environment variables. The entries below document configuration
# planned for later phases so that contributors know in advance which values are secrets.
# Copy this file to `.env` for local use. `.env` is git-ignored; never commit real values.

# Planned (Phase 2): directory for per-run SQLite databases and event logs.
# MEMORYFENCE_RUNS_DIR=runs

# Planned (Phase 2): log verbosity for the structured event log.
# MEMORYFENCE_LOG_LEVEL=INFO

# Planned (Phase 7, optional): credentials for a hosted model provider.
# Hosted providers incur cost and are never required. The deterministic backend needs no key.
# MEMORYFENCE_PROVIDER_API_KEY=
